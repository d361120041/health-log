# ============================================
# PostgreSQL 配置
# ============================================
POSTGRES_HOST=postgres
POSTGRES_DB=health-log
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# Java 配置
# ============================================
HEALTH_LOG_JAVA_PORT=8080

SPRING_PROFILES_ACTIVE=local,dev

JWT_SECRET=your-secret-key-change-this-in-production-minimum-256-bits

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ============================================
# Vue.js 配置
# ============================================
HEALTH_LOG_VUE_PROTOCOL=http
HEALTH_LOG_VUE_HOST=host.docker.internal
HEALTH_LOG_VUE_PORT=80